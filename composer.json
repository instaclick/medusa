{
    "name": "instaclick/medusa",
    "description": "A small set of command to maintain a mirror of git repositories and create a local satis repository for composer.",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/composer": "^2.11",
        "guzzlehttp/guzzle": "^8.5",
        "symfony/console": "^5.4.47 || ^6.4.25 || ^7.1.10 || ^8.0",
        "symfony/finder": "^5.4.45 || ^6.4.24 || ^7.1.10 || ^8.0",
        "symfony/process": "^5.4.47 || ^6.4.25 || ^7.1.10 || ^8.0"
    },
    "authors": [
        {
            "name": "Sebastien Armand",
            "email": "khepin@gmail.com"
        },
        {
            "name": "Anthon Pang",
            "email": "apang@softwaredevelopment.ca",
            "role": "Fork maintainer"
        }
    ],
    "autoload": {
        "psr-0": {
            "Khepin": "src"
        }
    },
    "bin": [
        "bin/medusa"
    ],
    "config": {
        "platform": {
            "php": "8.0"
        }
    }
}
